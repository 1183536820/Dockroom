{
  "name": "dockroom-web",
  "private": true,
  "type": "module",
  "engines": {"node": "24.19.0"},
  "scripts": {
    "types": "openapi-typescript ../spec/openapi.yaml -o src/contract.d.ts",
    "check": "npm run types && tsc --noEmit",
    "build": "npm run check && vite build --base ./ --outDir ../internal/api/webdist --emptyOutDir false",
    "test": "playwright test"
  },
  "dependencies": {
    "@tanstack/react-query": "5.108.4",
    "@tanstack/react-table": "8.21.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/react": "19.3.1",
    "@types/react-dom": "19.3.0",
    "ajv": "8.20.0",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "yaml": "2.8.4"
  }
}
