{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Dockroom M1 device JSON frames (one per WebSocket message)",
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,47}$"},
    "ref": {
      "type": "object", "required": ["nodeId", "rootId", "parts"], "additionalProperties": false,
      "properties": {"nodeId": {"$ref": "#/$defs/id"}, "rootId": {"$ref": "#/$defs/id"}, "parts": {"type": "array", "maxItems": 128, "items": {"type": "string"}}}
    },
    "root": {
      "type": "object", "required": ["rootId", "label", "mode", "binding"], "additionalProperties": false,
      "properties": {"rootId": {"$ref": "#/$defs/id"}, "label": {"type": "string", "minLength": 1, "maxLength": 100}, "mode": {"const": "readOnly"}, "canWrite": {"type": "boolean"}, "binding": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
    },
    "hello": {
      "type": "object", "required": ["major", "minor", "nodeId", "os", "version", "volumeCapability", "roots"], "additionalProperties": false,
      "properties": {"major": {"const": 1}, "minor": {"type": "integer", "minimum": 0}, "nodeId": {"$ref": "#/$defs/id"}, "os": {"enum": ["windows", "linux"]}, "version": {"type": "string"}, "volumeCapability": {"enum": ["ntfs", "openat2"]}, "roots": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/root"}}}
    },
    "command": {
      "type": "object", "required": ["protocol", "requestId", "nodeId", "attempt", "leaseEpoch", "deadline", "op", "payload"], "additionalProperties": false,
      "properties": {
        "protocol": {"const": 1}, "requestId": {"type": "string"}, "nodeId": {"$ref": "#/$defs/id"}, "attempt": {"const": 1}, "leaseEpoch": {"type": "integer", "minimum": 1}, "deadline": {"type": "string", "format": "date-time"}, "op": {"enum": ["list", "resolve", "src_info", "src_hash", "src_block", "src_put", "dst_info", "dst_begin", "dst_get", "dst_verify", "dst_publish", "dst_reconcile"]},
        "payload": {"type": "object", "required": ["user", "ref"], "additionalProperties": false, "properties": {"user": {"type": "string"}, "ref": {"$ref": "#/$defs/ref"}, "filter": {"type": "string"}, "cursor": {"type": "string"}, "input": {"type": "string"}, "copy": {"$ref": "#/$defs/copy"}}}
      }
    },
    "copy": {
      "type": "object", "additionalProperties": false,
      "properties": {"version": {"type": "string"}, "id": {"type": "string"}, "name": {"type": "string"}, "parent": {"type": "string"}, "size": {"type": "integer", "minimum": 0}, "offset": {"type": "integer", "minimum": 0}, "length": {"type": "integer", "minimum": 1, "maximum": 8388608}, "token": {"type": "string"}, "digest": {"type": "string"}, "mtime": {"type": "string", "format": "date-time"}}
    },
    "response": {
      "type": "object", "required": ["requestId"], "additionalProperties": false,
      "oneOf": [{"required": ["result"]}, {"required": ["error"]}],
      "properties": {"requestId": {"type": "string"}, "result": {"type": "object"}, "error": {"type": "object", "required": ["code", "message", "requestId", "retryable"], "properties": {"code": {"type": "string"}, "message": {"type": "string"}, "requestId": {"type": "string"}, "retryable": {"type": "boolean"}}}}
    }
  },
  "oneOf": [{"$ref": "#/$defs/hello"}, {"$ref": "#/$defs/command"}, {"$ref": "#/$defs/response"}]
}
